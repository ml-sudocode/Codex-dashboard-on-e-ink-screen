CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 1 ms ticks: the DC-DC soft start needs 2 ms delays
CONFIG_FREERTOS_HZ=1000
# logs on the badge's USB port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# app_update.c: esp-serial-flasher over USB host CDC-ACM
CONFIG_SERIAL_FLASHER_PORT_USB_CDC_ACM=y
# a new version must reach the home screen once, or the bootloader goes back to the old one
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
