CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 1 ms ticks: the DC-DC soft start needs 2 ms delays
CONFIG_FREERTOS_HZ=1000
# logs on the badge's USB port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# app_update.c: esp-serial-flasher over USB host CDC-ACM
CONFIG_SERIAL_FLASHER_PORT_USB_CDC_ACM=y
# a new version must reach the home screen once, or the bootloader goes back to the old one
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# apps run on the home screen task: give them room (TLS in the Online app needs it)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# a crash leaves its backtrace in flash: idf.py coredump-info after the reboot
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_WIFI_FTM_ENABLE=y

# Online update speed: 240 MHz for TLS, a 64 KB TCP window, Wi-Fi/LWIP buffers may live in PSRAM
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
